# Copy this file to .env.local and fill in your own Supabase project's values.
# Find these in your Supabase project: Settings -> API.
# These are safe to expose to the browser (NEXT_PUBLIC_*) — access is enforced
# by Row Level Security policies in the database, not by keeping this secret.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
